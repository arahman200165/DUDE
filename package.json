{
  "name": "dude",
  "version": "0.0.27",
  "description": "DUDE — Developer Utility Dashboard Engine: a dark-mode-only, offline-capable PWA of client-side developer micro-tools, also shipping as a Windows Electron desktop build.",
  "author": "arahman200165",
  "main": "dist/electron/main.js",
  "engines": {
    "npm": "11.19.0",
    "node": "^24.15.0"
  },
  "scripts": {
    "ng": "ng",
    "lint": "eslint .",
    "prestart": "npm run generate:registry",
    "start": "ng serve",
    "build": "ng build",
    "postbuild": "node scripts/check-cache-budget.mjs",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run generate:registry",
    "test": "ng test",
    "prebuild": "npm run generate:registry",
    "test:e2e": "ng build && playwright test --config=e2e/playwright.config.ts",
    "test:electron": "vitest run --config vitest.electron.config.mts",
    "test:perf": "vitest run --config vitest.perf.config.mts",
    "test:high-consequence": "node scripts/check-high-consequence-gate.mjs",
    "playwright:install": "playwright install chromium",
    "generate:registry": "node scripts/generate-tool-registry.mjs && node scripts/generate-file-associations.mjs && node scripts/generate-readme-tools.mjs && node scripts/generate-security-doc.mjs",
    "generate:brand-assets": "node scripts/generate-brand-assets.mjs",
    "electron:compile": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --outdir=dist/electron --external:electron",
    "electron:start": "ng build --configuration production,electron && npm run electron:compile && electron dist/electron/main.js",
    "electron:dev": "concurrently -k -s first \"ng serve\" \"wait-on http://localhost:4200 && npm run electron:compile && cross-env DUDE_ELECTRON_DEV_SERVER_URL=http://localhost:4200 electron dist/electron/main.js\"",
    "electron:package": "ng build --configuration production,electron && npm run electron:compile && electron-builder --config electron-builder.yml --win nsis appx",
    "measure:desktop-startup": "ng build --configuration production,electron && npm run electron:compile && node scripts/measure-desktop-startup.mjs",
    "relay:compile": "esbuild relay/index.ts --bundle --platform=node --format=cjs --outdir=dist/relay",
    "relay:dev": "npm run relay:compile && node dist/relay/index.js"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/cdk": "^22.1.7",
    "@angular/common": "^22.1.0",
