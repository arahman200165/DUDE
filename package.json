{
  "name": "dude",
  "version": "0.0.0",
  "description": "DUDE — Developer Utility Dashboard Engine: a dark-first, themeable, offline-capable PWA of client-side developer micro-tools, also shipping as a Windows Electron desktop build.",
  "author": "arahman200165",
  "main": "dist/electron/main.js",
  "engines": {
    "npm": "11.19.0",
    "node": "^24.15.0"
  },
  "scripts": {
    "ng": "ng",
    "lint": "eslint . && npm run check:boundaries && npm run check:design && npm run check:inventory",
    "check:design": "node scripts/check-design-tokens.mjs --enforce && node scripts/generate-theme-css.mjs --check && node scripts/check-theme-contrast.mjs",
    "prestart": "npm run generate:registry && npm run build:packages",
    "start": "concurrently -k \"npm run watch:packages\" \"ng serve\"",
    "build": "ng build",
    "postbuild": "node scripts/generate-offline-map.mjs && node scripts/check-cache-budget.mjs",
    "watch": "concurrently -k \"npm run watch:packages\" \"ng build --watch --configuration development\"",
    "pretest": "npm run generate:registry && npm run build:packages",
    "test": "npm run test:packages && ng test",
    "prebuild": "npm run generate:registry && npm run build:packages",
    "build:hub-web": "ng build --configuration production,hub",
    "postbuild:hub-web": "node scripts/generate-offline-map.mjs dist/hub-web/browser ngsw-config.hub.json && node scripts/check-cache-budget.mjs dist/hub-web/browser",
    "prebuild:hub-web": "npm run generate:registry && npm run build:packages",
    "test:e2e": "npm run build && playwright test --config=e2e/playwright.config.ts",
    "test:appearance": "npm run build && playwright test --config=e2e/appearance/playwright.appearance.config.ts",
    "test:electron": "vitest run --config vitest.electron.config.mts",
    "test:e2e:hub": "playwright test --config=e2e/hub/playwright.hub.config.ts",
    "test:e2e:sync": "ng build --configuration production,electron && npm run electron:compile && npm run hub:compile && playwright test --config=e2e/sync/playwright.sync.config.ts",
    "measure:hub": "node scripts/measure-hub.mjs",
    "measure:sync": "node scripts/measure-sync.mjs",
    "measure:hub-web": "node scripts/measure-hub-web.mjs",
    "measure:backup": "node scripts/measure-backup.mjs",
    "test:hub": "vitest run --config vitest.hub.config.mts",
    "test:sync": "vitest run --config vitest.electron.config.mts apps/device-agent/src/sync/sync-integration.spec.ts",
    "test:perf": "vitest run --config vitest.perf.config.mts",
    "test:high-consequence": "node scripts/check-high-consequence-gate.mjs",
    "playwright:install": "playwright install chromium",
    "generate:registry": "node scripts/generate-theme-css.mjs && node scripts/generate-tool-registry.mjs && node scripts/generate-mobile-bindings.mjs && node scripts/generate-panel-registry.mjs && node scripts/generate-file-associations.mjs && node scripts/generate-readme-tools.mjs && node scripts/generate-security-doc.mjs && node scripts/generate-web-manifest.mjs && node scripts/check-workspace-inventory.mjs && node scripts/data-scope-inventory.mjs",
    "generate:brand-assets": "node scripts/generate-brand-assets.mjs",
    "electron:helper": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-network-helper.ps1",
    "preelectron:dev": "npm run generate:registry && npm run build:packages && npm run electron:helper",
    "preelectron:start": "npm run generate:registry && npm run build:packages && npm run electron:helper",
    "preelectron:package": "npm run generate:registry && npm run build:packages && npm run electron:helper",
    "electron:compile": "esbuild apps/desktop/main.ts apps/desktop/preload.ts apps/desktop/fs-worker.ts --bundle --platform=node --format=cjs --outdir=dist/electron --external:electron && npm run device-agent:compile",
    "device-agent:compile": "node scripts/build-device-agent.mjs",
    "electron:start": "ng build --configuration production,electron && npm run electron:compile && electron dist/electron/main.js",
    "electron:dev": "concurrently -k -s first \"ng serve\" \"wait-on http://localhost:4200 && npm run electron:compile && cross-env DUDE_ELECTRON_DEV_SERVER_URL=http://localhost:4200 electron dist/electron/main.js\"",
    "electron:package": "ng build --configuration production,electron && npm run electron:compile && npm run agent:sea && npm run hub:stage && npm run hub:installer && electron-builder --config electron-builder.yml --win nsis",
    "measure:desktop-startup": "ng build --configuration production,electron && npm run electron:compile && node scripts/measure-desktop-startup.mjs",
    "relay:compile": "esbuild apps/collab-relay/index.ts --bundle --platform=node --format=cjs --outdir=dist/relay",
    "hub:compile": "node scripts/build-hub.mjs",
    "hub:compile:test": "node scripts/build-hub.mjs --test",
    "hub:sea": "node scripts/build-hub-sea.mjs",
    "hub:winsw": "node scripts/fetch-winsw.mjs",
    "hub:stage": "npm run hub:sea && npm run hub:winsw && node scripts/stage-hub.mjs",
    "hub:installer": "node scripts/build-hub-installer.mjs",
    "check:caddy-proxy": "node scripts/check-caddy-proxy.mjs",
    "check:hub-service": "node scripts/check-hub-service.mjs",
    "hub:dev": "npm run hub:compile && node dist/hub/dude-hub.cjs run --data-dir .hub-dev",
    "relay:dev": "npm run relay:compile && node dist/relay/index.js",
    "build:packages": "node scripts/build-packages.mjs",
    "watch:packages": "node scripts/build-packages.mjs --watch",
    "test:packages": "vitest run --config vitest.packages.config.mts",
    "check:boundaries": "node scripts/check-package-boundaries.mjs && node scripts/check-mobile-boundaries.mjs",
    "preelectron:compile": "npm run generate:registry && npm run build:packages",
    "prerelay:compile": "npm run build:packages",
    "prehub:sea": "npm run hub:compile",
    "check:dockerfiles": "node scripts/check-dockerfiles.mjs",
    "prehub:compile": "npm run build:packages",
    "prelint": "npm run build:packages",
    "pretest:high-consequence": "npm run generate:registry && npm run build:packages",
    "pretest:electron": "npm run hub:compile",
    "pretest:hub": "npm run hub:compile",
    "pretest:sync": "npm run hub:compile",
    "pretest:perf": "npm run build:packages",
    "prewatch": "npm run generate:registry && npm run build:packages",
    "check:portable": "node scripts/check-portable-consumption.mjs",
    "check:inventory": "node scripts/check-workspace-inventory.mjs --check && node scripts/data-scope-inventory.mjs --check",
    "check:clean": "node scripts/check-clean-workspace.mjs",
    "precheck:hosts": "npm run build:packages",
    "check:hosts": "tsc -p apps/desktop/tsconfig.json && tsc -p apps/collab-relay/tsconfig.json && tsc -p apps/hub/tsconfig.json",
    "check:desktop": "node scripts/check-desktop-workspace.mjs",
    "check:generated": "node scripts/check-generator-freshness.mjs",
    "audit:prod": "node scripts/check-production-audit.mjs",
    "pretest:packages": "npm run build:packages",
    "agent:sea": "node scripts/build-sea.mjs --bundle dist/electron/device-agent.js --out dist/agent --name dude-agent",
    "preagent:sea": "npm run device-agent:compile",
    "precheck:mobile": "npm run build:packages",
    "check:mobile": "npm run check --workspace=@dude/mobile && node scripts/check-mobile-boundaries.mjs",
    "test:mobile": "node --test tests/mobile-boundaries.test.mjs tests/mobile-bindings.test.mjs tests/mobile-shell.test.mjs tests/mobile-native-privacy.test.mjs && vitest run --config vitest.mobile.config.mts",
    "premobile:start": "npm run build:packages",
    "mobile:start": "npm run start --workspace=@dude/mobile",
    "mobile:prebuild": "npm run prebuild --workspace=@dude/mobile",
    "premobile:android": "npm run build:packages",
    "mobile:android": "npm run android --workspace=@dude/mobile",
    "premobile:bundle": "npm run build:packages",
    "mobile:bundle": "npm run bundle --workspace=@dude/mobile"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@angular/service-worker": "^22.2.1",
    "@cfworker/json-schema": "4.1.1",
    "@faker-js/faker": "^10.6.0",
    "@fastify/type-provider-typebox": "6.1.0",
    "@fastify/websocket": "11.3.1",
    "@msgpack/msgpack": "^3.1.3",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@sindresorhus/slugify": "^3.0.1",
    "@tiptap/core": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@zxing/library": "^0.23.0",
    "ajv": "^8.20.0",
    "base-x": "^5.0.1",
    "bson": "^7.3.3",
    "cbor-x": "^1.6.6",
    "chrono-node": "^2.10.1",
    "colord": "^2.10.0",
    "cron-parser": "^5.10.1",
    "cronstrue": "^3.24.0",
    "diff-match-patch": "^1.0.5",
    "dompurify": "^3.4.16",
    "echarts": "^6.1.0",
    "ejs": "^6.0.1",
    "electron-updater": "^6.8.9",
    "exifr": "^7.1.3",
    "fast-json-patch": "^3.1.1",
    "fast-xml-parser": "^5.11.1",
    "fastest-levenshtein": "^1.0.16",
    "fastify": "5.12.5",
    "fflate": "^0.8.3",
    "figlet": "^1.11.4",
    "franc-min": "^6.2.0",
    "gridstack": "14.0.0",
    "humanize-duration": "^3.35.0",
    "hyparquet": "^1.31.1",
    "iconv-lite": "^0.7.3",
    "ini": "^7.0.0",
    "isomorphic-git": "^1.42.2",
    "jmespath": "^0.16.0",
    "jose": "^6.2.12",
    "js-md5": "^0.9.2",
    "js-yaml": "^5.4.2",
    "jsbarcode": "^3.12.3",
    "jsonpath-plus": "^10.4.0",
    "jsonrepair": "^3.15.0",
    "jsqr": "^1.4.0",
    "lib0": "^0.2.117",
    "luxon": "^3.7.2",
    "markdown-it": "^15.0.2",
    "markdown-it-task-lists": "^2.1.1",
    "mathjs": "^15.2.0",
    "metaphone": "^2.0.1",
    "nanoid": "^6.0.1",
    "node-forge": "^1.4.0",
    "node-sql-parser": "^5.4.0",
    "papaparse": "^5.7.0",
    "parse-duration": "^2.1.9",
    "picomatch": "^4.0.7",
    "pixelmatch": "^7.2.0",
    "protobufjs": "^8.8.0",
    "punycode": "^2.3.1",
    "pyodide": "^314.0.7",
    "qrcode": "^1.5.4",
    "railroad-diagrams": "^1.0.0",
    "regexp-tree": "^0.1.27",
    "rfc4648": "^1.5.4",
    "rrule": "^2.8.1",
    "rxjs": "~7.8.0",
    "semver": "^7.8.5",
    "smol-toml": "^1.8.0",
    "soundex-code": "^2.0.1",
    "specificity": "^1.0.0",
    "sql-formatter": "^15.9.0",
    "sql.js": "^1.14.2",
    "svgo": "^4.1.0",
    "tiptap-markdown": "^0.9.0",
    "tslib": "^2.3.0",
    "typebox": "1.3.34",
    "ua-parser-js": "^2.0.10",
    "ulid": "^3.0.2",
    "unicode-name": "^1.2.1",
    "uuid": "^14.0.2",
    "ws": "^8.21.3",
    "xmllint-wasm": "^5.3.0",
    "xxhash-wasm": "^1.1.0",
    "y-protocols": "^1.0.7",
    "yaml": "^2.9.1",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@babel/generator": "7.29.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/diff-match-patch": "^1.0.36",
    "@types/ejs": "^3.1.5",
    "@types/humanize-duration": "^3.27.4",
    "@types/ini": "^4.1.1",
    "@types/jmespath": "^0.15.2",
    "@types/jsbarcode": "^3.11.4",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.6.2",
    "@types/node-forge": "^1.3.14",
    "@types/papaparse": "^5.5.2",
    "@types/picomatch": "^4.0.3",
    "@types/punycode": "^2.1.4",
    "@types/qrcode": "^1.5.6",
    "@types/semver": "^7.8.0",
    "@types/sql.js": "^1.4.11",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "avsc": "^5.7.9",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "postject": "1.0.0-alpha.6",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.1.0"
  },
  "allowScripts": {
    "electron@44.4.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.24.2": true,
    "@parcel/watcher@2.6.0": true,
    "electron-winstaller@5.4.0": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  }
}
