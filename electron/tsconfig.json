{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "outDir": "../out-tsc/electron",
    "rootDir": ".."
  },
  "include": ["./**/*.ts", "../src/shared-logic/**/*.ts", "../collab-relay/**/*.ts"],
  "exclude": ["../src/shared-logic/**/*.spec.ts", "../collab-relay/**/*.spec.ts"]
}
