{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "dude": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "ejs.min.js",
                "input": "node_modules/ejs",
                "output": "assets/vendor/"
              },
              {
                "glob": "{pyodide.js,pyodide.asm.mjs,pyodide.asm.wasm,pyodide-lock.json,python_stdlib.zip}",
                "input": "node_modules/pyodide",
                "output": "assets/vendor/pyodide/"
              },
              {
                "glob": "{xmllint-browser.mjs,xmllint.wasm}",
                "input": "node_modules/xmllint-wasm"
              },
              {
                "glob": "sql-wasm-browser.wasm",
                "input": "node_modules/sql.js/dist",
                "output": "assets/vendor/sql.js/"
              }
            ],
            "styles": ["src/styles.css"],
            "webWorkerTsConfig": "tsconfig.worker.json",
            "allowedCommonJsDependencies": ["diff-match-patch", "papaparse", "jmespath", "cron-parser", "cronstrue", "node-forge", "railroad-diagrams"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                },
                {
                  "type": "anyScript",
                  "maximumWarning": "500kB",
                  "maximumError": "3MB"
                }
              ],
              "outputHashing": "all",
              "serviceWorker": "ngsw-config.json",
              "statsJson": true,
              "baseHref": "/DUDE/"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "electron": {
              "baseHref": "/",
              "serviceWorker": false
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "headers": {
              "Access-Control-Allow-Origin": "*"
            }
          },
          "configurations": {
            "production": {
              "buildTarget": "dude:build:production"
            },
            "development": {
              "buildTarget": "dude:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "setupFiles": ["src/testing/fast-check.setup.ts"]
          }
        }
      }
    }
  }
}
