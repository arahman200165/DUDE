  "semanticSets": {
    "standard": {
      "dark": {
        "standard": {
          "error": "#ff5757",
          "warning": "#d99a00",
          "success": "#46e05a",
          "info": "#4294ff",
          "busy": "#c966ff",
          "offline": "#8c97a8"
        }
      },
      "light": {
        "standard": {
          "error": "#a91b1b",
