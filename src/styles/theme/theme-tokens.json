  "density": {
    "compact": {
      "spacing": "0.25rem",
      "control-h": "1.75rem",
      "row-h": "1.75rem",
      "radius": "0.25rem",
      "text-ui": "0.8125rem",
      "text-ui-sm": "0.75rem",
      "text-ui-xs": "0.6875rem",
      "space-micro": "0.25rem",
      "space-normal": "0.5rem",
      "space-panel": "0.75rem",
      "space-major": "1rem",
      "space-exceptional": "1.5rem"
    }
  },
  "fonts": {
    "ui": [
      {
        "id": "system",
        "label": "System UI",
        "stack": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif"
      }
    ],
    "mono": [
      {
        "id": "default",
        "label": "JetBrains Mono / Fira Code",
        "stack": "'JetBrains Mono', 'Fira Code', ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace"
      }
    ],
    "defaultUi": "system",
    "defaultMono": "default"
  }
}
