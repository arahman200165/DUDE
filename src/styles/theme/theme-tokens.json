{
  "axes": {
    "theme": {
      "attr": "data-theme",
      "values": ["dark", "light"],
      "default": "dark",
      "labels": { "dark": "Dark", "light": "Light" }
    },
    "contrast": {
      "attr": "data-contrast",
      "values": ["standard"],
      "default": "standard",
      "labels": { "standard": "Standard" }
    },
    "accent": {
      "attr": "data-accent",
      "values": ["cyan", "blue", "violet", "green", "amber", "magenta"],
      "default": "cyan",
      "labels": {
        "cyan": "Cyan",
        "blue": "Blue",
        "violet": "Violet",
        "green": "Green",
        "amber": "Amber",
        "magenta": "Magenta"
      }
    },
    "catset": {
      "attr": "data-catset",
      "values": ["vivid", "soft", "cvd"],
      "default": "vivid",
      "labels": { "vivid": "Vivid", "soft": "Soft", "cvd": "Color-blind safe" }
    },
    "semantic": {
      "attr": "data-semantic",
      "values": ["standard"],
      "default": "standard",
      "labels": { "standard": "Standard" }
    },
    "density": {
      "attr": "data-density",
      "values": ["compact"],
      "default": "compact",
      "labels": { "compact": "Compact" }
    }
  },
  "bases": {
    "dark": {
      "standard": {
        "bg": "#0a0e14",
        "panel": "#10151d",
        "panel-elevated": "#161c26",
        "border": "#232b38",
        "text": "#e6e9ef",
        "text-muted": "#8b93a3",
        "focus-width": "2px",
        "color-scheme": "dark",
        "scrim": "#000000",
        "wash-pct": "8%",
        "tint-toward": "white",
        "tint-pct": "20%"
      }
    },
    "light": {
      "standard": {
        "bg": "#eef1f5",
        "panel": "#ffffff",
        "panel-elevated": "#f6f8fc",
        "border": "#c5cdd8",
        "text": "#111827",
        "text-muted": "#475569",
        "focus-width": "2px",
        "color-scheme": "light",
        "scrim": "#0f172a",
        "wash-pct": "8%",
        "tint-toward": "black",
        "tint-pct": "20%"
      }
    }
  },
  "accents": {
    "cyan": {
      "dark": {
        "standard": { "accent": "#38d8ff", "on-accent": "#0a0e14" }
      },
      "light": {
        "standard": { "accent": "#035e91", "on-accent": "#ffffff" }
      }
    },
    "blue": {
      "dark": {
        "standard": { "accent": "#80b0ff", "on-accent": "#0a0e14" }
      },
      "light": {
        "standard": { "accent": "#003fa3", "on-accent": "#ffffff" }
      }
    },
    "violet": {
      "dark": {
        "standard": { "accent": "#a280ff", "on-accent": "#0a0e14" }
      },
      "light": {
        "standard": { "accent": "#4900b8", "on-accent": "#ffffff" }
      }
    },
    "green": {
      "dark": {
        "standard": { "accent": "#66ff94", "on-accent": "#0a0e14" }
      },
      "light": {
        "standard": { "accent": "#006627", "on-accent": "#ffffff" }
      }
    },
    "amber": {
      "dark": {
        "standard": { "accent": "#ffc042", "on-accent": "#0a0e14" }
      },
      "light": {
        "standard": { "accent": "#993d00", "on-accent": "#ffffff" }
      }
    },
    "magenta": {
      "dark": {
        "standard": { "accent": "#ff42ba", "on-accent": "#0a0e14" }
      },
      "light": {
        "standard": { "accent": "#a30067", "on-accent": "#ffffff" }
      }
    }
  },
