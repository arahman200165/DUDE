{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "types": ["react"],
    "paths": {}
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "src/**/*.ts", "src/**/*.tsx", "modules/**/*.ts", "app.config.ts", "expo-env.d.ts"],
  "exclude": ["android", "node_modules", "**/*.spec.ts", "**/*.spec.tsx"]
}
