{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/favicon.svg",
          "/index.html",
          "/manifest.webmanifest",
          "/offline-map.json",
          "/*.css",
          "/main-*.js"
        ]
      }
    },
    {
      "name": "tool-chunks",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/chunk-*.js", "/worker-*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"]
      }
    },
    {
      "name": "pyodide",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/assets/vendor/pyodide/**"]
      }
    },
    {
      "name": "xmllint-wasm",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/xmllint-browser.mjs", "/xmllint.wasm"]
      }
    },
    {
      "name": "sql.js",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/assets/vendor/sql.js/**"]
      }
    },
    {
      "name": "ejs",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/assets/vendor/ejs.min.js"]
      }
    }
  ]
}
